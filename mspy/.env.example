# Midscene Python 配置示例
# Midscene Python configuration example

# 模型配置 (Model configuration)
# 模型名称 (Model name)
MIDSCENE_MODEL_NAME=Local-Qwen3-VL-235B-A22B

# 模型 API 基础 URL (Model API base URL)
MIDSCENE_MODEL_BASE_URL=https://your-api-endpoint.com/v1

# 模型 API 密钥 (Model API key)
MIDSCENE_MODEL_API_KEY=your-api-key-here

# 模型家族 (Model family) - 支持 qwen3-vl, qwen2.5-vl, gemini, doubao-vision, vlm-ui-tars
MIDSCENE_MODEL_FAMILY=qwen3-vl

# HTTP 代理 (HTTP proxy)
MIDSCENE_MODEL_HTTP_PROXY=http://127.0.0.1:8888

# 可选配置 (Optional configuration)
# 模型超时时间，毫秒 (Model timeout in milliseconds)
# MIDSCENE_MODEL_TIMEOUT=60000

# 模型温度参数 (Model temperature)
# MIDSCENE_MODEL_TEMPERATURE=0

# 重规划循环限制 (Replanning cycle limit)
# MIDSCENE_REPLANNING_CYCLE_LIMIT=20
