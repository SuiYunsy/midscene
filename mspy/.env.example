# Midscene Python 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# =====================================================
# 模型配置（必需）
# =====================================================

# 模型名称 - 使用 qwen3-vl 家族
MIDSCENE_MODEL_NAME=qwen-vl-max-latest

# 模型家族 - 只支持 qwen2.5-vl 或 qwen3-vl
MIDSCENE_MODEL_FAMILY=qwen3-vl

# OpenAI 兼容 API 配置
MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MIDSCENE_MODEL_API_KEY=your-api-key-here

# =====================================================
# 可选配置
# =====================================================

# HTTP 代理（如果需要）
# MIDSCENE_MODEL_HTTP_PROXY=http://127.0.0.1:7890

# 模型温度（0-1，默认 0）
# MIDSCENE_MODEL_TEMPERATURE=0

# 请求超时（毫秒）
# MIDSCENE_MODEL_TIMEOUT=60000

# =====================================================
# 调试配置
# =====================================================

# 启用调试模式
# MIDSCENE_DEBUG_MODE=true

# 运行目录（日志、报告等）
# MIDSCENE_RUN_DIR=midscene_run

# 重规划周期限制
# MIDSCENE_REPLANNING_CYCLE_LIMIT=20
