# Midscene Python SDK Environment Configuration
# Copy this file to .env and fill in your values

# AI Model Configuration (Required)
MIDSCENE_MODEL_NAME=gpt-4o
MIDSCENE_MODEL_API_KEY=your-api-key-here

# API Base URL (Optional, defaults to OpenAI)
# MIDSCENE_MODEL_BASE_URL=https://api.openai.com/v1

# Model Family (Required for vision-language models)
# Options: qwen2.5-vl, qwen3-vl, doubao-vision, gemini, vlm-ui-tars
# MIDSCENE_MODEL_FAMILY=qwen2.5-vl

# Debug Mode (Optional)
# MIDSCENE_DEBUG_MODE=false

# Cache Configuration (Optional)
# MIDSCENE_CACHE=false

# Preferred Language for AI responses (Optional)
# MIDSCENE_PREFERRED_LANGUAGE=English
