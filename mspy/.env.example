# mspy 环境变量配置示例
# 将此文件复制为 .env 并填入你的配置

# ==========================================
# 模型配置（必填）
# ==========================================

# 模型名称（如 gpt-4o, gpt-4-vision-preview, qwen-vl-max 等）
MIDSCENE_MODEL_NAME=gpt-4o

# 模型 API 密钥
MIDSCENE_MODEL_API_KEY=your-api-key-here

# 模型 API 基础 URL（OpenAI 兼容接口）
MIDSCENE_MODEL_BASE_URL=https://api.openai.com/v1

# ==========================================
# 模型家族（VL 模型必填）
# ==========================================
# 可选值: qwen2.5-vl, qwen3-vl, doubao-vision, gemini, vlm-ui-tars
# MIDSCENE_MODEL_FAMILY=qwen2.5-vl

# ==========================================
# 可选配置
# ==========================================

# 模型超时时间（毫秒）
# MIDSCENE_MODEL_TIMEOUT=120000

# 模型温度（0-2，默认 0）
# MIDSCENE_MODEL_TEMPERATURE=0

# 最大 token 数
# MIDSCENE_MODEL_MAX_TOKENS=4096

# ==========================================
# 代理设置（可选）
# ==========================================

# HTTP 代理
# MIDSCENE_MODEL_HTTP_PROXY=http://127.0.0.1:7890

# SOCKS 代理
# MIDSCENE_MODEL_SOCKS_PROXY=socks5://127.0.0.1:1080

# ==========================================
# 高级配置（可选）
# ==========================================

# 缓存开关
# MIDSCENE_CACHE=true

# 强制深度思考
# MIDSCENE_FORCE_DEEP_THINK=false

# 首选语言
# MIDSCENE_PREFERRED_LANGUAGE=Chinese

# 运行目录
# MIDSCENE_RUN_DIR=midscene_run

# ==========================================
# 独立模型配置（可选，用于不同任务使用不同模型）
# ==========================================

# Insight 模型（用于元素定位和数据提取）
# MIDSCENE_INSIGHT_MODEL_NAME=gpt-4o
# MIDSCENE_INSIGHT_MODEL_API_KEY=your-api-key
# MIDSCENE_INSIGHT_MODEL_BASE_URL=https://api.openai.com/v1

# Planning 模型（用于任务规划）
# MIDSCENE_PLANNING_MODEL_NAME=gpt-4o
# MIDSCENE_PLANNING_MODEL_API_KEY=your-api-key
# MIDSCENE_PLANNING_MODEL_BASE_URL=https://api.openai.com/v1
