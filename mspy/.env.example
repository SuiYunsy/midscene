# Midscene Python SDK 环境配置示例
# Midscene Python SDK Environment Configuration Example

# 模型配置 / Model Configuration
MIDSCENE_MODEL_NAME=Local-Qwen3-VL-235B-A22B
MIDSCENE_MODEL_FAMILY=qwen3-vl
MIDSCENE_MODEL_BASE_URL=https://your-api-endpoint.com/v1
MIDSCENE_MODEL_API_KEY=your-api-key-here

# HTTP代理配置 / HTTP Proxy Configuration  
# 格式: http://host:port 或 http://user:pass@host:port
MIDSCENE_MODEL_HTTP_PROXY=http://localhost:8888

# 跳过证书验证 / Skip Certificate Verification
# 如果使用自签名证书或代理，设置为true
MIDSCENE_MODEL_SKIP_CERT_VERIFICATION=true

# 可选配置 / Optional Configuration

# 模型温度 / Model Temperature
# MIDSCENE_MODEL_TEMPERATURE=0

# 模型超时 / Model Timeout (milliseconds)
# MIDSCENE_MODEL_TIMEOUT=60000

# 重规划周期限制 / Replanning Cycle Limit
# MIDSCENE_REPLANNING_CYCLE_LIMIT=20

# 调试模式 / Debug Mode
# MIDSCENE_DEBUG_MODE=true
